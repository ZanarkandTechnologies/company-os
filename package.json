{
  "name": "hermes-company-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:state": "node scripts/check-ops-state.mjs",
    "check:manager": "node scripts/manager-state.mjs validate --state workspaces/howie-ai/ops/manager-state.json",
    "manager": "node scripts/manager-state.mjs",
    "manager:cycle": "node scripts/run-manager-cycle.mjs",
    "board:sync": "node scripts/sync-filesystem-kanban.mjs",
    "company": "node scripts/company-manager.mjs",
    "company:demo": "node scripts/company-manager.mjs seed --workspace /tmp/howie-demo --write",
    "eval:company-manager": "node scripts/run-company-manager-evals.mjs",
    "dashboard": "node scripts/serve-dashboard.mjs",
    "site": "node scripts/serve-sme-site.mjs",
    "test:site": "node --test tests/sme-site.test.mjs",
    "demo:render": "node scripts/render-company-manager-demo.mjs",
    "deliver:company": "node scripts/deliver-company-chases.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "frappe-gantt": "^1.2.2"
  }
}
